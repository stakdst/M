// mapeditor.js
// 屋台現在地表示アプリ 地図・描画・吸着部品（作業2）
(function (global) {
  'use strict';

  var MapEditor = {};

  // ------------------------------------------------------------
  // 内部状態
  // ------------------------------------------------------------

  var map = null;
  var mapElement = null;
  var currentMode = 'view';

  var strokeCallback = null;
  var mapTapCallback = null;

  var drawing = false;
  var activePointerId = null;
  var rawStroke = [];

  var rawPreviewLayer = null;
  var snappedPreviewLayer = null;

  var routeLayer = null;
  var checkpointLayer = null;
  var simulationMarker = null;
  var busyElement = null;

  var DEFAULT_CENTER = [34.725, 137.855];
  var DEFAULT_ZOOM = 16;

  var OSRM_BASE = 'https://routing.openstreetmap.de/routed-foot';

  // ------------------------------------------------------------
  // 補助関数
  // ------------------------------------------------------------

  function isValidPoint(point) {
    return Array.isArray(point) &&
      point.length === 2 &&
      typeof point[0] === 'number' &&
      isFinite(point[0]) &&
      typeof point[1] === 'number' &&
      isFinite(point[1]) &&
      point[0] >= -90 &&
      point[0] <= 90 &&
      point[1] >= -180 &&
      point[1] <= 180;
  }

  function copyPoint(point) {
    return [point[0], point[1]];
  }

  function copyPath(path) {
    if (!Array.isArray(path)) {
      return [];
    }

    return path.map(function (point) {
      return copyPoint(point);
    });
  }

  function coreDistance(a, b) {
    if (!global.Core ||
        typeof global.Core.distance !== 'function') {
      throw new Error(
        'Core.distance が利用できません。core.js を先に読み込んでください。'
      );
    }

    return global.Core.distance(a, b);
  }

  function getMapContainer() {
    if (!map) {
      return null;
    }

    return map.getContainer();
  }

  function setTouchAction(value) {
    var container = getMapContainer();

    if (!container) {
      return;
    }

    container.style.touchAction = value;
  }

  function setMapInteractions(enabled) {
    if (!map) {
      return;
    }

    if (enabled) {
      map.dragging.enable();
      map.scrollWheelZoom.enable();
      map.doubleClickZoom.enable();
      map.boxZoom.enable();
      map.keyboard.enable();
      map.touchZoom.enable();
    } else {
      map.dragging.disable();
      map.scrollWheelZoom.disable();
      map.doubleClickZoom.disable();
      map.boxZoom.disable();
      map.keyboard.disable();
      map.touchZoom.disable();
    }
  }

  function removeLayer(layer) {
    if (!map || !layer) {
      return;
    }

    map.removeLayer(layer);
  }

  function eventToPoint(event) {
    if (!event || !event.latlng) {
      return null;
    }

    var lat = Number(event.latlng.lat);
    var lng = Number(event.latlng.lng);

    if (!isFinite(lat) || !isFinite(lng)) {
      return null;
    }

    return [lat, lng];
  }

  function stopEvent(event) {
    if (!event) {
      return;
    }

    if (typeof event.preventDefault === 'function') {
      event.preventDefault();
    }

    if (typeof event.stopPropagation === 'function') {
      event.stopPropagation();
    }
  }

  // ------------------------------------------------------------
  // 描画用 Pointer Events
  // ------------------------------------------------------------

  function addDrawingPoint(event) {
    var point = eventToPoint(event);

    if (!point) {
      return;
    }

    if (rawStroke.length === 0) {
      rawStroke.push(point);
      return;
    }

    var previous = rawStroke[rawStroke.length - 1];

    // あまりに細かい点を大量に記録しない。
    if (coreDistance(previous, point) >= 2) {
      rawStroke.push(point);
    }
  }

  function pointerDown(event) {
    if (currentMode !== 'draw') {
      return;
    }

    if (drawing) {
      return;
    }

    stopEvent(event);

    drawing = true;
    activePointerId = event.pointerId;
    rawStroke = [];

    if (event.currentTarget &&
        typeof event.currentTarget.setPointerCapture === 'function') {
      try {
        event.currentTarget.setPointerCapture(event.pointerId);
      } catch (error) {
        // Pointer Capture が利用できない場合も描画は続ける。
      }
    }

    addDrawingPoint(event);
  }

  function pointerMove(event) {
    if (!drawing) {
      return;
    }

    if (event.pointerId !== activePointerId) {
      return;
    }

    stopEvent(event);
    addDrawingPoint(event);
  }

  function pointerUp(event) {
    if (!drawing) {
      return;
    }

    if (event.pointerId !== activePointerId) {
      return;
    }

    stopEvent(event);

    if (event.currentTarget &&
        typeof event.currentTarget.releasePointerCapture === 'function') {
      try {
        event.currentTarget.releasePointerCapture(event.pointerId);
      } catch (error) {
        // Pointer Capture の解除失敗は描画結果に影響しない。
      }
    }

    drawing = false;
    activePointerId = null;

    var points = rawStroke.slice();
    rawStroke = [];

    if (points.length < 2) {
      return;
    }

    if (typeof strokeCallback === 'function') {
      strokeCallback(points);
    }
  }

  function pointerCancel(event) {
    if (!drawing) {
      return;
    }

    if (event.pointerId !== activePointerId) {
      return;
    }

    stopEvent(event);

    drawing = false;
    activePointerId = null;
    rawStroke = [];
  }

  function bindPointerEvents() {
    var container = getMapContainer();

    if (!container) {
      return;
    }

    container.addEventListener(
      'pointerdown',
      pointerDown,
      { passive: false }
    );

    container.addEventListener(
      'pointermove',
      pointerMove,
      { passive: false }
    );

    container.addEventListener(
      'pointerup',
      pointerUp,
      { passive: false }
    );

    container.addEventListener(
      'pointercancel',
      pointerCancel,
      { passive: false }
    );
  }

  // ------------------------------------------------------------
  // 初期化
  // ------------------------------------------------------------

  MapEditor.init = function (elementId, options) {
    if (!global.L) {
      throw new Error(
        'Leaflet が読み込まれていません。'
      );
    }

    var element = document.getElementById(elementId);

    if (!element) {
      throw new Error(
        '地図要素が見つかりません: ' + elementId
      );
    }

    options = options || {};

    var center = Array.isArray(options.center) &&
      options.center.length === 2
      ? options.center
      : DEFAULT_CENTER;

    var zoom = typeof options.zoom === 'number'
      ? options.zoom
      : DEFAULT_ZOOM;

    if (map) {
      map.remove();
      map = null;
    }

    mapElement = element;

    map = global.L.map(elementId, {
      center: center,
      zoom: zoom,
      zoomControl: true
    });

    global.L.tileLayer(
      'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
      {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
      }
    ).addTo(map);

    routeLayer = global.L.layerGroup().addTo(map);
    checkpointLayer = global.L.layerGroup().addTo(map);

    bindPointerEvents();

    MapEditor.setMode('view');

    return map;
  };

  // ------------------------------------------------------------
  // モード切り替え
  // ------------------------------------------------------------

  MapEditor.setMode = function (mode) {
    if (mode !== 'view' &&
        mode !== 'draw' &&
        mode !== 'checkpoint') {
      throw new Error(
        'mode は view、draw、checkpoint のいずれかです。'
      );
    }

    currentMode = mode;
    drawing = false;
    activePointerId = null;
    rawStroke = [];

    if (!map) {
      return;
    }

    if (mode === 'draw') {
      setMapInteractions(false);
      setTouchAction('none');

      map.getContainer().style.cursor = 'crosshair';
    } else {
      setMapInteractions(true);
      setTouchAction('auto');

      if (mode === 'checkpoint') {
        map.getContainer().style.cursor = 'crosshair';
      } else {
        map.getContainer().style.cursor = '';
      }
    }
  };

  // ------------------------------------------------------------
  // なぞり終了 callback
  // ------------------------------------------------------------

  MapEditor.onStrokeEnd = function (callback) {
    if (typeof callback === 'function') {
      strokeCallback = callback;
    } else {
      strokeCallback = null;
    }
  };

  // ------------------------------------------------------------
  // OSRM用の点列間引き
  // ------------------------------------------------------------

  function simplifyPoints(rawPoints) {
    if (!Array.isArray(rawPoints)) {
      throw new Error(
        'rawPoints は配列で指定してください。'
      );
    }

    var points = rawPoints.filter(function (point) {
      return isValidPoint(point);
    }).map(function (point) {
      return copyPoint(point);
    });

    if (points.length < 2) {
      throw new Error(
        '吸着には2点以上の軌跡が必要です。'
      );
    }

    var interval = 25;
    var sampled;

    function sampleByInterval(target) {
      var result = [points[0]];
      var last = points[0];
      var i;

      for (i = 1; i < points.length; i++) {
        if (coreDistance(last, points[i]) >= target) {
          result.push(points[i]);
          last = points[i];
        }
      }

      var lastPoint = points[points.length - 1];

      if (coreDistance(result[result.length - 1], lastPoint) > 0) {
        result.push(lastPoint);
      }

      return result;
    }

    sampled = sampleByInterval(interval);

    while (sampled.length > 100) {
      interval += 5;
      sampled = sampleByInterval(interval);

      if (interval > 100000) {
        sampled = [
          points[0],
          points[points.length - 1]
        ];
        break;
      }
    }

    return sampled;
  }

  // ------------------------------------------------------------
  // OSRM URL
  // ------------------------------------------------------------

  function makeCoordinateString(points) {
    return points.map(function (point) {
      // OSRM は経度,緯度の順。
      return String(point[1]) + ',' + String(point[0]);
    }).join(';');
  }

  function makeOSRMUrl(type, points) {
    return OSRM_BASE +
      '/' +
      type +
      '/v1/foot/' +
      makeCoordinateString(points) +
      '?geometries=geojson&overview=full';
  }

  function requestJson(url) {
    return fetch(url, {
      method: 'GET',
      mode: 'cors'
    }).then(function (response) {
      if (!response.ok) {
        throw new Error(
          'OSRM HTTPエラー: ' + response.status
        );
      }

      return response.json();
    });
  }

  // ------------------------------------------------------------
  // OSRM結果から [緯度,経度] の path を作る
  // ------------------------------------------------------------

  function geometryToPath(geometry) {
    if (!geometry ||
        geometry.type !== 'LineString' ||
        !Array.isArray(geometry.coordinates)) {
      throw new Error(
        'OSRM の道路形状を取得できませんでした。'
      );
    }

    var path = [];

    geometry.coordinates.forEach(function (coordinate) {
      if (!Array.isArray(coordinate) ||
          coordinate.length < 2) {
        return;
      }

      var lng = Number(coordinate[0]);
      var lat = Number(coordinate[1]);

      if (!isFinite(lat) || !isFinite(lng)) {
        return;
      }

      // GeoJSON は経度,緯度なので、仕様の緯度,経度へ変換する。
      path.push([lat, lng]);
    });

    if (path.length < 2) {
      throw new Error(
        'OSRM の道路形状が短すぎます。'
      );
    }

    return path;
  }

  function getMatchPath(data) {
    if (!data ||
        data.code !== 'Ok' ||
        !Array.isArray(data.matchings)) {
      throw new Error(
        'OSRM /match が失敗しました。'
      );
    }

    // 結果が複数に分かれた場合は /route に切り替える。
    if (data.matchings.length !== 1) {
      throw new Error(
        'OSRM /match の結果が複数に分かれました。'
      );
    }

    return geometryToPath(
      data.matchings[0].geometry
    );
  }

  function getRoutePath(data) {
    if (!data ||
        data.code !== 'Ok' ||
        !Array.isArray(data.routes) ||
        data.routes.length === 0) {
      throw new Error(
        'OSRM /route が失敗しました。'
      );
    }

    return geometryToPath(
      data.routes[0].geometry
    );
  }

  // ------------------------------------------------------------
  // 吸着
  // ------------------------------------------------------------

  MapEditor.snap = function (rawPoints) {
    var points;

    try {
      points = simplifyPoints(rawPoints);
    } catch (error) {
      return Promise.reject(error);
    }

    MapEditor.setBusy(true);

    var matchUrl = makeOSRMUrl(
      'match',
      points
    );

    return requestJson(matchUrl)
      .then(function (matchData) {
        try {
          return getMatchPath(matchData);
        } catch (matchError) {
          // /match が失敗した場合は /route を使う。
          var routeUrl = makeOSRMUrl(
            'route',
            points
          );

          return requestJson(routeUrl)
            .then(function (routeData) {
              return getRoutePath(routeData);
            });
        }
      })
      .then(function (path) {
        MapEditor.setBusy(false);
        return copyPath(path);
      })
      .catch(function (error) {
        MapEditor.setBusy(false);
        throw error;
      });
  };

  // ------------------------------------------------------------
  // プレビュー
  // ------------------------------------------------------------

  MapEditor.showPreview = function (raw, snapped) {
    if (!map) {
      return;
    }

    MapEditor.clearPreview();

    if (Array.isArray(raw)) {
      var rawPath = raw.filter(isValidPoint);

      if (rawPath.length >= 2) {
        rawPreviewLayer = global.L.polyline(
          rawPath,
          {
            weight: 5,
            opacity: 0.35,
            color: '#777777',
            lineCap: 'round',
            lineJoin: 'round',
            interactive: false
          }
        ).addTo(map);
      }
    }

    if (Array.isArray(snapped)) {
      var snappedPath = snapped.filter(isValidPoint);

      if (snappedPath.length >= 2) {
        snappedPreviewLayer = global.L.polyline(
          snappedPath,
          {
            weight: 7,
            opacity: 0.9,
            color: '#333333',
            lineCap: 'round',
            lineJoin: 'round',
            interactive: false
          }
        ).addTo(map);
      }
    }
  };

  MapEditor.clearPreview = function () {
    removeLayer(rawPreviewLayer);
    removeLayer(snappedPreviewLayer);

    rawPreviewLayer = null;
    snappedPreviewLayer = null;
  };

  // ------------------------------------------------------------
  // 地図タップ
  // ------------------------------------------------------------

  function mapClick(event) {
    if (currentMode !== 'checkpoint') {
      return;
    }

    if (typeof mapTapCallback !== 'function') {
      return;
    }

    var point = eventToPoint(event);

    if (!point) {
      return;
    }

    mapTapCallback(point);
  }

  MapEditor.onMapTap = function (callback) {
    mapTapCallback =
      typeof callback === 'function'
        ? callback
        : null;

    if (!map) {
      return;
    }

    map.off('click', mapClick);

    if (mapTapCallback) {
      map.on('click', mapClick);
    }
  };

  // ------------------------------------------------------------
  // day の描画
  // ------------------------------------------------------------

  MapEditor.render = function (day) {
    if (!map) {
      return;
    }

    if (!routeLayer) {
      routeLayer = global.L.layerGroup().addTo(map);
    }

    if (!checkpointLayer) {
      checkpointLayer = global.L.layerGroup().addTo(map);
    }

    routeLayer.clearLayers();
    checkpointLayer.clearLayers();

    if (!day || typeof day !== 'object') {
      return;
    }

    var path = Array.isArray(day.path)
      ? day.path.filter(isValidPoint)
      : [];

    if (path.length >= 2) {
      global.L.polyline(
        path,
        {
          weight: 7,
          opacity: 0.85,
          color: '#333333',
          lineCap: 'round',
          lineJoin: 'round'
        }
      ).addTo(routeLayer);
    } else if (path.length === 1) {
      global.L.circleMarker(
        path[0],
        {
          radius: 6,
          weight: 2
        }
      ).addTo(routeLayer);
    }

    if (!Array.isArray(day.checkpoints)) {
      return;
    }

    day.checkpoints.forEach(function (checkpoint, index) {
      if (!checkpoint ||
          typeof checkpoint !== 'object' ||
          !Number.isInteger(checkpoint.idx)) {
        return;
      }

      if (checkpoint.idx < 0 ||
          checkpoint.idx >= path.length) {
        return;
      }

      var point = path[checkpoint.idx];

      var icon = global.L.divIcon({
        className: 'mapeditor-checkpoint-icon',
        html:
          '<div style="' +
          'width:28px;' +
          'height:28px;' +
          'border-radius:50%;' +
          'background:#ffffff;' +
          'border:3px solid #333333;' +
          'box-sizing:border-box;' +
          'display:flex;' +
          'align-items:center;' +
          'justify-content:center;' +
          'font-weight:bold;' +
          'font-size:14px;' +
          'color:#111111;' +
          '">' +
          String(index + 1) +
          '</div>',
        iconSize: [28, 28],
        iconAnchor: [14, 14]
      });

      global.L.marker(
        point,
        {
          icon: icon,
          interactive: false
        }
      ).addTo(checkpointLayer);
    });
  };

  // ------------------------------------------------------------
  // シミュレーション用マーカー
  // ------------------------------------------------------------

  MapEditor.showMarker = function (point) {
    if (!map) {
      return;
    }

    if (simulationMarker) {
      map.removeLayer(simulationMarker);
      simulationMarker = null;
    }

    if (point === null || point === undefined) {
      return;
    }

    if (!isValidPoint(point)) {
      return;
    }

    simulationMarker = global.L.circleMarker(
      point,
      {
        radius: 9,
        weight: 3
      }
    ).addTo(map);
  };

  // ------------------------------------------------------------
  // ルート全体を表示
  // ------------------------------------------------------------

  MapEditor.fitToPath = function (path) {
    if (!map) {
      return;
    }

    if (!Array.isArray(path)) {
      return;
    }

    var validPath = path.filter(isValidPoint);

    if (validPath.length === 0) {
      return;
    }

    if (validPath.length === 1) {
      map.setView(
        validPath[0],
        DEFAULT_ZOOM
      );
      return;
    }

    var bounds = global.L.latLngBounds(
      validPath
    );

    if (!bounds.isValid()) {
      return;
    }

    map.fitBounds(
      bounds,
      {
        padding: [20, 20],
        maxZoom: 18
      }
    );
  };

  // ------------------------------------------------------------
  // 通信中表示
  // ------------------------------------------------------------

  MapEditor.setBusy = function (flag) {
    if (!mapElement) {
      return;
    }

    if (!busyElement) {
      busyElement = document.createElement('div');

      busyElement.style.position = 'absolute';
      busyElement.style.left = '50%';
      busyElement.style.top = '12px';
      busyElement.style.transform = 'translateX(-50%)';
      busyElement.style.zIndex = '10000';
      busyElement.style.padding = '8px 14px';
      busyElement.style.borderRadius = '18px';
      busyElement.style.background = 'rgba(0, 0, 0, 0.75)';
      busyElement.style.color = '#ffffff';
      busyElement.style.fontSize = '14px';
      busyElement.style.fontWeight = 'bold';
      busyElement.style.pointerEvents = 'none';
      busyElement.style.alignItems = 'center';
      busyElement.style.justifyContent = 'center';
      busyElement.textContent = '道路に合わせています…';

      if (getComputedStyle(mapElement).position === 'static') {
        mapElement.style.position = 'relative';
      }

      mapElement.appendChild(busyElement);
    }

    busyElement.style.display =
      flag ? 'flex' : 'none';
  };

  // ------------------------------------------------------------
  // 公開
  // ------------------------------------------------------------

  global.MapEditor = MapEditor;

})(window);
